<style>
  srow: height=40 padding=0,8,0,12 align=center gap=10 radius=5 border-width=0,0,1,0 border-color=#f2e8d80f
  sname: mono=true font-size=12.5 font-weight=600 color=#f2e8d8
  sval: mono=true font-size=12 color=#6f6a63
  btn: height=24 padding=0,9,0,9 font-size=11 font-weight=600 color=#a99f8f background=#f2e8d80a border-width=1 border-color=#f2e8d81f radius=4
  del: height=24 padding=0,9,0,9 font-size=11 font-weight=600 color=#ff7b72 background=#ff7b720d border-width=1 border-color=#ff7b7240 radius=4
  @when (hover) { srow: background=#f2e8d808 }
  @when (revealed) { sval: color=#5ce1e6 }
</style>
<row id="row" class="srow" width="100%">
  <text id="name" class="sname" nowrap="true" width="230" clip="true">{name}</text>
  <text id="value" class="sval" nowrap="true" grow="1" shrink="1" basis="0" clip="true">{value}</text>
  <control id="copy" class="btn" value="Copy name" width="82" />
  <control id="reveal" class="btn" value="Show" width="58" />
  <control id="edit" class="btn" value="Edit" width="50" />
  <control id="delete" class="del" value="Delete" width="62" />
</row>
